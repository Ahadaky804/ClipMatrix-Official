# ClipMatrix Phase 2 — Python FastAPI Backend Environment Configuration
# Copy this file to backend/.env on your local server. Never commit real .env files.

# Google Gemini API Key (Required for AI Highlight Detection & AI Captions)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# PostgreSQL Connection Parameters (Object/discrete parameters)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="clipmatrix"
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"

# Redis & Celery Background Worker Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Local faster-whisper Configuration
# Supported sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE="base"
# Device: cpu (default) or cuda (when NVIDIA GPU is available)
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Media Storage Root
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB="500"
